# prebuilts.just — two-step SDK prebuilts workflow.
# Imported by the root Justfile.
#
# Step 1: `just update-prebuilts`
#   Builds the K/N static archives from the upstream SDK working tree and
#   refreshes internal/sdk/prebuilt/. After this you can `go run`, `go install`,
#   `go build`, etc. directly — no GitHub round-trip needed.
#
# Step 2: `just publish-prebuilts v0.0.X`
#   Packs the current internal/sdk/prebuilt/* into tarballs, publishes them as
#   a release on spilikin/zeta-sdk, bumps VERSION + CHECKSUMS.txt in this repo,
#   verifies the fetcher pulls the new release. Run only when you're ready to
#   ship; ideally after `just update-prebuilts` + local testing.
#
# Override the local clone of the release-host repo with:
#   SDK_RELEASE_REPO=/path/to/clone just publish-prebuilts v0.0.X

sdk_release_repo := absolute_path(env_var_or_default("SDK_RELEASE_REPO", internal_root / ".." / "zeta-sdk-spilikin"))

# Build SDK static archives + refresh local prebuilt/ tree (no publish).
update-prebuilts:
    #!/usr/bin/env bash
    set -euo pipefail
    # Builds K/N static archives from ../zeta-sdk and copies them into
    # internal/sdk/prebuilt/. After this, your local `go build` / `go run` /
    # `go install` consumes the freshly-built SDK without going through
    # GitHub Releases. Iteration-friendly: re-run as you patch upstream.
    echo ">>> [1/2] building SDK static archives (macOS arm64 + Windows amd64)"
    just sdk-macos-static-arm64
    just sdk-windows-static-mingw
    just sdk-windows-static-deps

    echo ">>> [2/2] refreshing local prebuilt tree"
    just refresh-prebuilts-macos
    just refresh-prebuilts-windows

    echo ""
    echo "✓ local prebuilts updated. Try: go build ./... && go run ./internal/cmd/..."

# Publish current prebuilts as a GitHub release on spilikin/zeta-sdk, bump
# CHECKSUMS, verify fetcher. Run after `just update-prebuilts` + local testing.
# Optional env: SDK_RELEASE_NOTES="custom release notes text"
publish-prebuilts version:
    #!/usr/bin/env bash
    set -euo pipefail
    [[ -d "{{sdk_release_repo}}/.git" ]] \
        || { echo "no SDK release repo at {{sdk_release_repo}} (set SDK_RELEASE_REPO=)" >&2; exit 1; }
    command -v gh >/dev/null \
        || { echo "gh CLI not found on PATH" >&2; exit 1; }
    gh auth status >/dev/null 2>&1 \
        || { echo "gh CLI not authenticated (run 'gh auth login')" >&2; exit 1; }
    if gh release view "{{version}}" --repo spilikin/zeta-sdk >/dev/null 2>&1; then
        echo "release {{version}} already exists on spilikin/zeta-sdk; pick a new version" >&2
        exit 2
    fi
    for f in libzeta_sdk.a libzeta_sdk_api.h; do
        [[ -f "{{internal_root}}/internal/sdk/prebuilt/darwin_arm64/$f" ]] \
            || { echo "missing internal/sdk/prebuilt/darwin_arm64/$f — run 'just update-prebuilts' first" >&2; exit 3; }
        [[ -f "{{internal_root}}/internal/sdk/prebuilt/windows_amd64/$f" ]] \
            || { echo "missing internal/sdk/prebuilt/windows_amd64/$f — run 'just update-prebuilts' first" >&2; exit 3; }
    done

    echo ">>> [1/4] packing tarballs into {{sdk_release_repo}}/dist/"
    mkdir -p "{{sdk_release_repo}}/dist"
    cd "{{internal_root}}/internal/sdk/prebuilt"
    COPYFILE_DISABLE=1 tar -czf "{{sdk_release_repo}}/dist/libzeta_sdk-darwin-arm64-{{version}}.tar.gz" \
        -C darwin_arm64 libzeta_sdk.a libzeta_sdk_api.h
    COPYFILE_DISABLE=1 tar -czf "{{sdk_release_repo}}/dist/libzeta_sdk-windows-amd64-{{version}}.tar.gz" \
        -C windows_amd64 libzeta_sdk.a libzeta_sdk_api.h libzeta_sdk.def deps

    echo ">>> [2/4] publishing GitHub release {{version}} on spilikin/zeta-sdk"
    cd "{{sdk_release_repo}}"
    notes="${SDK_RELEASE_NOTES:-Automated release built from upstream zeta-sdk working tree.}"
    gh release create "{{version}}" --title "{{version}}" --notes "$notes" \
        "dist/libzeta_sdk-darwin-arm64-{{version}}.tar.gz" \
        "dist/libzeta_sdk-windows-amd64-{{version}}.tar.gz"

    echo ">>> [3/4] bumping VERSION + CHECKSUMS.txt in binding repo"
    cd "{{internal_root}}/internal/sdk/prebuilt"
    echo "{{version}}" > VERSION
    {
        echo "# SHA256 checksums of per-target tarballs on the upstream SDK release."
        echo "# Format: BSD-style (\`shasum -a 256 file\`); one line per tarball."
        echo "# Generated by 'just publish-prebuilts' after a tagged SDK build."
        shasum -a 256 "{{sdk_release_repo}}/dist/libzeta_sdk-darwin-arm64-{{version}}.tar.gz" \
                      "{{sdk_release_repo}}/dist/libzeta_sdk-windows-amd64-{{version}}.tar.gz" \
            | awk '{ sub(".*/", "", $2); print }'
    } > CHECKSUMS.txt

    echo ">>> [4/4] verifying fetcher end-to-end (wipe + re-download + extract)"
    cd "{{internal_root}}"
    rm -rf internal/sdk/prebuilt/darwin_arm64 internal/sdk/prebuilt/windows_amd64
    # GitHub Releases CDN can lag a few seconds after gh release create
    sleep 5
    go run ./internal/cmd/fetch-prebuilts

    echo ""
    echo "✓ release {{version}} published on spilikin/zeta-sdk; CHECKSUMS bumped; fetcher verified"
    echo "  next: git diff + commit the bump, then 'just publish v0.0.X' the binding"
